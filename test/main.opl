
def run_func(x: lambda -> int, y: int) -> int {
	return x(y) * 2;
}

def example(x: int) -> int {
	return x * 2;
}

def test() -> lambda -> int {
	return $(x: int) -> int { return x * 2; };
}

def main() -> void {
	let funcs:[lambda -> int] = [];
	funcs.append($(x: int) -> int{return x * 2;});
	println(funcs[0](12));
}